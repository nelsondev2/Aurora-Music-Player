+/* =====================================================================
+ *  tests/e2e/flow.test.js
+ *  Recorridos de extremo a extremo sobre la app real (index.html +
+ *  scripts) en jsdom: onboarding, importación de audio, reproducción,
+ *  favoritos, creación de listas, búsqueda y exportación.
+ *
+ *  No hay Chromium en el sandbox: jsdom cubre DOM, eventos, IndexedDB
+ *  (fake) y los mismos módulos que usa el navegador. Lo que jsdom no
+ *  puede validar (layout real, códecs, Web Audio) se audita aparte.
+ * ===================================================================== */
+
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { boot, waitFor } = require('../helpers/dom-env');
+
+/* Crea un File de jsdom con bytes válidos de relleno (ID3 vacío). */
+function makeAudioFile(w, name, size = 2048) {
+  const bytes = new Uint8Array(size);
+  bytes[0] = 0x49; bytes[1] = 0x44; bytes[2] = 0x33; // "ID3"
+  return new w.File([bytes], name, { type: 'audio/mpeg' });
+}
+
+function click(w, el) {
+  el.dispatchEvent(new w.MouseEvent('click', { bubbles: true }));
+}
+
+test('e2e: onboarding → importar → reproducir → favorito → lista', async (t) => {
+  // El arnés fija aurora_lang por comodidad en el resto de suites; para
+  // probar el primer arranque hay que borrarla antes de cargar los scripts.
+  const env = await boot({ beforeScripts: (w) => w.localStorage.removeItem('aurora_lang') });
+  t.after(env.close);
+  const { App, window: w } = env;
+  const doc = w.document;
+
+  // 1. Primer arranque: el onboarding de idioma es obligatorio (init lo
+  // programa con 350 ms de retraso para no competir con el arranque).
+  const onboarding = doc.getElementById('sheetLanguage');
+  await waitFor(() => onboarding.classList.contains('open'), 3000);
+  assert.ok(onboarding.classList.contains('open'), 'el onboarding debe abrirse');
+  assert.ok(onboarding.classList.contains('onboarding'));
+  // El click en el backdrop no lo cierra (se debe elegir idioma).
+  click(w, onboarding.querySelector('.sheet-backdrop'));
+  assert.ok(onboarding.classList.contains('open'), 'el onboarding no debe cerrarse por backdrop');
+
+  // 2. Elegir español en la lista real.
+  const esOption = doc.querySelector('#langList li[data-lang="es"]') ||
+    Array.from(doc.querySelectorAll('#langList li')).find((li) =>
+      /es/i.test(li.dataset.lang || '') || /Español/i.test(li.textContent));
+  assert.ok(esOption, 'debe existir la opción de español');
+  click(w, esOption);
+  assert.equal(onboarding.classList.contains('open'), false, 'el onboarding se cierra al elegir');
+  assert.equal(w.localStorage.getItem('aurora_lang'), 'es');
+
+  // 3. Importar dos archivos de audio (ruta real del uploader).
+  await App.handleFileInput([
+    makeAudioFile(w, 'Primera Cancion.mp3'),
+    makeAudioFile(w, 'Artista - Segunda Cancion.mp3')
+  ]);
+  assert.equal(App.tracks.length, 2, 'deben importarse 2 pistas');
+
+  // 4. La biblioteca lista las pistas.
+  App.openSheet('sheetLibrary');
+  App.renderLibrary();
+  const rows = doc.querySelectorAll('#libraryTracks .track-row');
+  assert.equal(rows.length, 2);
+
+  // 5. Click en la fila: reproduce y actualiza el mini-player.
+  click(w, rows[0]);
+  await new Promise((r) => setTimeout(r, 30));
+  assert.ok(App.currentTrack, 'debe haber pista actual');
+  assert.equal(App.isPlaying, true, 'al pulsar la fila debe reproducir');
+  assert.notEqual(doc.getElementById('miniPlayerTitle').textContent, '—');
+
+  // 6. Favorito desde el botón de corazón de Now Playing.
+  App.closeSheet('sheetLibrary');
+  App.openNowPlaying();
+  click(w, doc.getElementById('btnLike'));
+  assert.equal(App.favorites.has(App.currentTrack.id), true, 'la pista debe quedar favorita');
+
+  // 7. Crear una lista desde el sheet real.
+  App.openCreatePlaylistSheet();
+  doc.getElementById('playlistName').value = 'Mi lista E2E';
+  click(w, doc.getElementById('btnSavePlaylist'));
+  await new Promise((r) => setTimeout(r, 20));
+  const created = App.playlists.find((p) => p.name === 'Mi lista E2E');
+  assert.ok(created, 'la lista debe crearse');
+
+  // 8. Exportar: la descarga se genera con un Blob y un <a download>.
+  App.tracks.forEach((tr) => { tr._needsRelink = false; });
+  let created_url = null;
+  const origCreate = w.URL.createObjectURL;
+  w.URL.createObjectURL = (blob) => { created_url = blob; return 'blob:e2e'; };
+  const origClick = w.HTMLAnchorElement.prototype.click;
+  let downloaded = null;
+  w.HTMLAnchorElement.prototype.click = function () { downloaded = this.download; };
+  try {
+    await App.exportLibrary();
+  } finally {
+    w.URL.createObjectURL = origCreate;
+    w.HTMLAnchorElement.prototype.click = origClick;
+  }
+  assert.equal(downloaded, 'aurora-backup.json');
+  assert.ok(created_url && created_url.type === 'application/json');
+});
+
+test('e2e: búsqueda con debounce filtra la biblioteca', async (t) => {
+  const env = await boot();
+  t.after(env.close);
+  const { App, window: w } = env;
+  const doc = w.document;
+
+  await App.handleFileInput([
+    makeAudioFile(w, 'Alpha Song.mp3'),
+    makeAudioFile(w, 'Beta Tune.mp3')
+  ]);
+
+  App.openSheet('sheetSearch');
+  const input = doc.getElementById('searchInput');
+  input.value = 'alpha';
+  input.dispatchEvent(new w.Event('input', { bubbles: true }));
+  // El handler tiene debounce de 150 ms.
+  await waitFor(() => {
+    const rows = doc.querySelectorAll('#searchResults .track-row, #searchResults .search-result');
+    return rows.length === 1;
+  }, 3000);
+  const text = doc.getElementById('searchResults').textContent.toLowerCase();
+  assert.ok(text.includes('alpha'));
+  assert.equal(text.includes('beta'), false);
+});
+
+test('e2e: cambio de tema y acento se refleja y persiste', async (t) => {
+  const env = await boot();
+  t.after(env.close);
+  const { App, window: w } = env;
+  const root = w.document.documentElement;
+
+  App.setTheme('light');
+  assert.equal(root.getAttribute('data-theme'), 'light');
+  assert.equal(w.localStorage.getItem('aurora_theme'), 'light');
+
+  const accents = Object.keys(App.ACCENTS || {});
+  assert.ok(accents.length > 0, 'debe haber acentos');
+  const accent = accents[0];
+  App.setAccent(accent);
+  assert.equal(root.getAttribute('data-accent'), accent);
+  assert.equal(w.localStorage.getItem('aurora_accent'), accent);
+});
diff --git a/tests/helpers/dom-env.js b/tests/helpers/dom-env.js
new file mode 100644
index 0000000..a730d71
--- /dev/null
+++ b/tests/helpers/dom-env.js
@@ -0,0 +1,312 @@
+/* =====================================================================
+ *  tests/helpers/dom-env.js
+ *  Arranca la app real (index.html + todos los scripts) dentro de jsdom
+ *  con IndexedDB falso. Sin navegador: sirve para unit/integración/e2e
+ *  de la lógica y del DOM.
+ * ===================================================================== */
+
+'use strict';
+
+const fs = require('fs');
+const path = require('path');
+const { JSDOM, VirtualConsole } = require('jsdom');
+const { IDBFactory, IDBKeyRange } = require('fake-indexeddb');
+
+const ROOT = path.resolve(__dirname, '..', '..');
+const INDEX = path.join(ROOT, 'index.html');
+
+/* Extrae los <script src> del HTML y los quita: se inyectan como scripts
+ * inline para no depender del resource loader de jsdom (file://). */
+function extractScripts(html) {
+  const scripts = [];
+  const cleaned = html.replace(/<script\s+[^>]*src="([^"]+)"[^>]*>\s*<\/script>/g, (m, src) => {
+    scripts.push(src);
+    return '';
+  });
+  return { html: cleaned, scripts };
+}
+
+function makeCanvasContext(canvas) {
+  const gradient = { addColorStop() {} };
+  const data = new Map();
+  return new Proxy({}, {
+    get(target, prop) {
+      if (prop === 'canvas') return canvas;
+      if (prop === 'measureText') return () => ({ width: 10 });
+      if (prop === 'createLinearGradient' || prop === 'createRadialGradient' || prop === 'createPattern') {
+        return () => gradient;
+      }
+      if (prop === 'getImageData') {
+        return (x, y, w, h) => ({ data: new Uint8ClampedArray(Math.max(1, w * h * 4)) });
+      }
+      if (prop === 'createImageData') {
+        return (w, h) => ({ data: new Uint8ClampedArray(Math.max(1, w * h * 4)) });
+      }
+      if (prop in target) return target[prop];
+      return () => {};
+    },
+    set(target, prop, value) {
+      target[prop] = value;
+      data.set(prop, value);
+      return true;
+    }
+  });
+}
+
+function installMocks(w) {
+  const state = {
+    blobs: new Map(),
+    blobSeq: 0,
+    unhandled: []
+  };
+
+  w.__testState = state;
+
+  /* IndexedDB aislado por instancia */
+  w.indexedDB = new IDBFactory();
+  w.IDBKeyRange = IDBKeyRange;
+  w.IDBFactory = IDBFactory;
+
+  /* Object URLs con mapa para que fetch() devuelva el blob real */
+  w.URL.createObjectURL = (blob) => {
+    const url = 'blob:mock/' + (++state.blobSeq);
+    state.blobs.set(url, blob);
+    return url;
+  };
+  w.URL.revokeObjectURL = (url) => { state.blobs.delete(url); };
+  w.fetch = async (url) => {
+    if (state.blobs.has(url)) return { ok: true, blob: async () => state.blobs.get(url) };
+    return { ok: false, status: 404, blob: async () => new w.Blob([]) };
+  };
+
+  /* localStorage: jsdom la ofrece con URL http */
+  try { w.localStorage.setItem('aurora_lang', 'es'); } catch (e) {}
+
+  /* matchMedia */
+  w.matchMedia = (query) => ({
+    matches: false,
+    media: query,
+    onchange: null,
+    addEventListener() {}, removeEventListener() {},
+    addListener() {}, removeListener() {}, dispatchEvent() { return false; }
+  });
+
+  /* Canvas */
+  const originalGetContext = w.HTMLCanvasElement.prototype.getContext;
+  w.HTMLCanvasElement.prototype.getContext = function (type) {
+    if (type && type !== '2d') return originalGetContext ? originalGetContext.call(this, type) : null;
+    if (!this.__ctx) this.__ctx = makeCanvasContext(this);
+    return this.__ctx;
+  };
+  w.HTMLCanvasElement.prototype.toDataURL = function () {
+    return 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==';
+  };
+  w.HTMLCanvasElement.prototype.toBlob = function (cb) {
+    cb(new w.Blob(['x'], { type: 'image/png' }));
+  };
+
+  /* Media elements: jsdom no implementa play/pause/load ni metadatos. */
+  const mediaProto = w.HTMLMediaElement.prototype;
+  Object.defineProperty(mediaProto, 'paused', {
+    configurable: true,
+    get() { return this.__paused !== false; }
+  });
+  Object.defineProperty(mediaProto, 'ended', {
+    configurable: true,
+    get() { return this.__ended === true; }
+  });
+  Object.defineProperty(mediaProto, 'duration', {
+    configurable: true,
+    get() { return typeof this.__duration === 'number' ? this.__duration : 180; }
+  });
+  Object.defineProperty(mediaProto, 'currentTime', {
+    configurable: true,
+    get() { return this.__currentTime || 0; },
+    set(v) {
+      const n = Number(v);
+      if (!Number.isFinite(n)) throw new w.DOMException('non-finite', 'TypeError');
+      this.__currentTime = Math.max(0, n);
+    }
+  });
+  Object.defineProperty(mediaProto, 'readyState', {
+    configurable: true,
+    get() { return 4; }
+  });
+  Object.defineProperty(mediaProto, 'play', {
+    configurable: true,
+    value: function () {
+      this.__paused = false;
+      this.__ended = false;
+      this.dispatchEvent(new w.Event('play'));
+      this.dispatchEvent(new w.Event('playing'));
+      return Promise.resolve();
+    }
+  });
+  Object.defineProperty(mediaProto, 'pause', {
+    configurable: true,
+    value: function () {
+      if (this.__paused === false) this.dispatchEvent(new w.Event('pause'));
+      this.__paused = true;
+    }
+  });
+  Object.defineProperty(mediaProto, 'load', {
+    configurable: true,
+    value: function () {
+      this.dispatchEvent(new w.Event('loadstart'));
+      // Simula metadatos disponibles en el siguiente tick.
+      const self = this;
+      w.setTimeout(() => {
+        if (typeof self.__duration !== 'number') self.__duration = 180;
+        self.dispatchEvent(new w.Event('loadedmetadata'));
+        self.dispatchEvent(new w.Event('canplay'));
+      }, 0);
+    }
+  });
+  Object.defineProperty(mediaProto, 'buffered', {
+    configurable: true,
+    get() { return { length: 0, end() { return 0; } }; }
+  });
+
+  /* navigator.storage / mediaSession / vibrate */
+  const nav = w.navigator;
+  Object.defineProperty(nav, 'storage', {
+    configurable: true,
+    value: {
+      estimate: async () => ({ usage: 1024 * 1024, quota: 1024 * 1024 * 100 }),
+      persist: async () => true,
+      persisted: async () => true
+    }
+  });
+  w.MediaMetadata = class MediaMetadata {
+    constructor(o) { Object.assign(this, o || {}); }
+  };
+  Object.defineProperty(nav, 'mediaSession', {
+    configurable: true,
+    value: {
+      metadata: null,
+      playbackState: 'none',
+      handlers: {},
+      setActionHandler(action, handler) { this.handlers[action] = handler; },
+      setPositionState(s) {
+        if (!s) return;
+        if (!Number.isFinite(s.position) || !Number.isFinite(s.duration)) {
+          throw new w.DOMException('bad position', 'TypeError');
+        }
+        this.positionState = s;
+      }
+    }
+  });
+  nav.vibrate = () => true;
+  Object.defineProperty(nav, 'wakeLock', {
+    configurable: true,
+    value: { request: async () => ({ release: async () => {} }) }
+  });
+
+  /* APIs varias que usa la app */
+  w.scrollTo = () => {};
+  w.Element.prototype.scrollIntoView = function () {};
+  w.ResizeObserver = class ResizeObserver {
+    observe() {} unobserve() {} disconnect() {}
+  };
+  w.requestIdleCallback = (cb) => setTimeout(() => cb({ didTimeout: false, timeRemaining: () => 0 }), 0);
+  w.cancelIdleCallback = (id) => clearTimeout(id);
+  // Usar los timers del window: window.close() los cancela y los tests
+  // no dejan el proceso vivo (el visualizador y las letras usan RAF).
+  w.requestAnimationFrame = (cb) => w.setTimeout(() => cb(Date.now()), 16);
+  w.cancelAnimationFrame = (id) => w.clearTimeout(id);
+  w.structuredClone = global.structuredClone;
+  w.alert = () => {};
+  w.confirm = () => false;
+  w.prompt = () => null;
+  w.print = () => {};
+  w.console = w.console || console;
+
+  /* AudioContext no existe en jsdom: la app lo detecta y degrada. */
+  delete w.AudioContext;
+  delete w.webkitAudioContext;
+
+  /* File/Blob del window deben soportar arrayBuffer() y text() */
+  if (w.Blob && !w.Blob.prototype.arrayBuffer) {
+    w.Blob.prototype.arrayBuffer = async function () {
+      return new Uint8Array(await new Response(this).arrayBuffer()).buffer;
+    };
+  }
+
+  w.addEventListener('unhandledrejection', (e) => {
+    state.unhandled.push(String(e.reason));
+  });
+}
+
+function waitFor(fn, timeoutMs = 8000, interval = 20) {
+  return new Promise((resolve, reject) => {
+    const start = Date.now();
+    const tick = () => {
+      let val = false;
+      try { val = fn(); } catch (e) { val = false; }
+      if (val) return resolve(val);
+      if (Date.now() - start > timeoutMs) return reject(new Error('waitFor timeout'));
+      setTimeout(tick, interval);
+    };
+    tick();
+  });
+}
+
+/**
+ * Arranca la app.
+ * @param {object} [opts]
+ * @param {number} [opts.timeout] ms de espera para App._initialized
+ * @param {function} [opts.beforeScripts] (window) => void, antes de inyectar
+ * @returns {Promise<{dom, window, App, logs, close}>}
+ */
+async function boot(opts = {}) {
+  const source = fs.readFileSync(INDEX, 'utf8');
+  const { html, scripts } = extractScripts(source);
+  const logs = { errors: [], warnings: [], jsdomErrors: [] };
+
+  const virtualConsole = new VirtualConsole();
+  virtualConsole.on('jsdomError', (err) => {
+    logs.jsdomErrors.push(String(err && err.message));
+  });
+  virtualConsole.on('error', (...args) => logs.errors.push(args.map(String).join(' ')));
+  virtualConsole.on('warn', (...args) => logs.warnings.push(args.map(String).join(' ')));
+
+  const dom = new JSDOM(html, {
+    url: 'http://localhost:3000/',
+    runScripts: 'dangerously',
+    pretendToBeVisual: true,
+    virtualConsole,
+    beforeParse: installMocks
+  });
+  const w = dom.window;
+
+  if (typeof opts.beforeScripts === 'function') opts.beforeScripts(w);
+
+  for (const src of scripts) {
+    const abs = path.join(ROOT, src);
+    let code = fs.readFileSync(abs, 'utf8');
+    // Con cobertura activa, istanbul instrumenta cada script antes de
+    // inyectarlo: c8 no ve el VM de jsdom y sin esto la cobertura de la
+    // app sería ficticia.
+    if (process.env.AURORA_COVERAGE === '1' && global.__coverageCollector) {
+      code = global.__coverageCollector.instrument(code, abs);
+    }
+    const el = w.document.createElement('script');
+    el.textContent = code;
+    w.document.body.appendChild(el);
+  }
+
+  // main.js arranca en DOMContentLoaded o de inmediato si ya cargó.
+  await waitFor(() => w.App && w.App._initialized, opts.timeout || 8000);
+
+  const close = () => {
+    // Recoger la cobertura del realm ANTES de cerrar el window.
+    if (process.env.AURORA_COVERAGE === '1' && global.__coverageCollector) {
+      try { global.__coverageCollector.merge(w.__coverage__); } catch (e) {}
+    }
+    try { w.close(); } catch (e) {}
+  };
+
+  return { dom, window: w, App: w.App, logs, close };
+}
+
+module.exports = { boot, waitFor, ROOT, INDEX };
