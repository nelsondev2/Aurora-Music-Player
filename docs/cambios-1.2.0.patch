+  const A = env.App;
+  A.tracks = [{ id: 'a', title: 'A', artist: 'X', duration: 1 }];
+  A.invalidateTrackIndex();
+  A.renderLibrary();
+  const chk = env.window.document.querySelector('.batch-checkbox');
+  assert.equal(chk.getAttribute('aria-label'), 'Seleccionar pista');
+  A.setLang('en');
+  A.renderLibrary();
+  assert.equal(env.window.document.querySelector('.batch-checkbox').getAttribute('aria-label'), 'Select track');
+});
diff --git a/tests/integration/wiring.test.js b/tests/integration/wiring.test.js
new file mode 100644
index 0000000..880bf53
--- /dev/null
+++ b/tests/integration/wiring.test.js
@@ -0,0 +1,137 @@
+/* =====================================================================
+ *  tests/integration/wiring.test.js
+ *  Contrato HTML ↔ JS: todo id que el código busca debe existir (o
+ *  crearse dinámicamente y estar documentado aquí). Detecta el tipo de
+ *  bug que dejó botones sin efecto tras el rediseño de la vista.
+ * ===================================================================== */
+
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('fs');
+const path = require('path');
+const { boot } = require('../helpers/dom-env');
+
+const ROOT = path.resolve(__dirname, '..', '..');
+const HTML = fs.readFileSync(path.join(ROOT, 'index.html'), 'utf8');
+const STATIC_IDS = new Set(Array.from(HTML.matchAll(/\bid="([^"]+)"/g), (m) => m[1]));
+
+/* Ids creados en tiempo de ejecución por la propia app (no están en el
+ * markup inicial) o usados como fallback de versiones anteriores. */
+const DYNAMIC_IDS = new Set([
+  'emptyState',        // js/library.js: estado vacío de la biblioteca
+  'lrcFileInput',      // js/lyrics.js: <input type=file> para .lrc
+  'btnResetHistory',   // js/library.js: botón del historial renderizado
+  'btnResetStats',     // js/stats-ui.js: botón del panel de estadísticas
+  'btnHomeLoad',       // js/nav.js: CTA del estado bienvenida
+  'homeHero',          // js/nav.js: tarjeta de reproducción reciente
+  'homeHeroCanvas',    // js/nav.js: portada de la tarjeta
+  'btnSleep'           // js/ui.js: fallback del botón antiguo (menú #menuSleep)
+]);
+
+test('wiring: todos los getElementById($) literales tienen markup o creación dinámica', () => {
+  const refs = new Map();
+  for (const file of fs.readdirSync(path.join(ROOT, 'js')).filter((f) => f.endsWith('.js'))) {
+    const src = fs.readFileSync(path.join(ROOT, 'js', file), 'utf8');
+    const patterns = [
+      /getElementById\(\s*'([A-Za-z0-9_-]+)'\s*\)/g,
+      /(?<![.\w$])\$\(\s*'([A-Za-z0-9_-]+)'\s*\)/g
+    ];
+    for (const re of patterns) {
+      for (const m of src.matchAll(re)) {
+        if (!refs.has(m[1])) refs.set(m[1], new Set());
+        refs.get(m[1]).add(file);
+      }
+    }
+  }
+  const missing = Array.from(refs.keys())
+    .filter((id) => !STATIC_IDS.has(id) && !DYNAMIC_IDS.has(id));
+  assert.deepEqual(missing, [], 'ids referenciados que no existen: ' + missing.join(', '));
+});
+
+test('wiring: data-close-sheet apunta a sheets existentes', () => {
+  const targets = Array.from(HTML.matchAll(/data-close-sheet="([^"]+)"/g), (m) => m[1]);
+  assert.ok(targets.length > 0);
+  const bad = targets.filter((id) => !STATIC_IDS.has(id));
+  assert.deepEqual(bad, [], 'data-close-sheet sin destino: ' + bad.join(', '));
+});
+
+test('wiring: ids únicos en el documento', async () => {
+  const env = await boot();
+  try {
+    const doc = env.window.document;
+    const seen = new Set();
+    const dup = [];
+    doc.querySelectorAll('[id]').forEach((el) => {
+      if (seen.has(el.id)) dup.push(el.id);
+      seen.add(el.id);
+    });
+    assert.deepEqual(dup, [], 'ids duplicados: ' + dup.join(', '));
+  } finally {
+    env.close();
+  }
+});
+
+test('wiring: los botones reales del modo lote están conectados', async () => {
+  const env = await boot();
+  const { App, window: w } = env;
+  try {
+    App.tracks = [
+      { id: 'w1', title: 'Uno', artist: 'A', album: 'B', duration: 100, fileName: '1.mp3', fileSize: 1 },
+      { id: 'w2', title: 'Dos', artist: 'A', album: 'B', duration: 100, fileName: '2.mp3', fileSize: 2 }
+    ];
+    App.openSheet('sheetLibrary');
+    App.renderLibrary();
+
+    const click = (id) => w.document.getElementById(id)
+      .dispatchEvent(new w.MouseEvent('click', { bubbles: true }));
+
+    // #btnBatchSelect debe activar el modo (no solo existir).
+    click('btnBatchSelect');
+    assert.equal(App._batchMode, true, 'btnBatchSelect no activó el modo lote');
+    assert.equal(w.document.getElementById('btnBatchSelect').getAttribute('aria-pressed'), 'true');
+
+    // #btnBatchSelectAll selecciona todas las pistas.
+    click('btnBatchSelectAll');
+    assert.equal(App._selectedTrackIds.size, 2);
+
+    // #btnBatchCancel sale del modo y limpia la selección.
+    click('btnBatchCancel');
+    assert.equal(App._batchMode, false);
+    assert.equal(App._selectedTrackIds.size, 0);
+  } finally {
+    env.close();
+  }
+});
+
+test('wiring: botones de reproducción y navegación responden', async () => {
+  const env = await boot();
+  const { App, window: w } = env;
+  try {
+    App.tracks = [{ id: 'p1', title: 'Pista', artist: 'A', album: 'B', duration: 100, fileName: 'p.mp3', fileSize: 3 }];
+    App.currentTrack = App.tracks[0];
+    const doc = w.document;
+    const clickPlay = () => doc.getElementById('btnPlay')
+      .dispatchEvent(new w.MouseEvent('click', { bubbles: true }));
+    const settle = () => new Promise((r) => setTimeout(r, 20));
+
+    clickPlay();
+    await settle();
+    assert.equal(App.isPlaying, true, 'btnPlay no inició la reproducción');
+    clickPlay();
+    await settle();
+    assert.equal(App.isPlaying, false, 'btnPlay no pausó');
+    clickPlay();
+    await settle();
+    assert.equal(App.isPlaying, true, 'btnPlay no reanudó');
+
+    // Navegación inferior: cada botón abre su sheet.
+    const libBtn = doc.querySelector('.nav-btn[data-nav="library"]');
+    libBtn.dispatchEvent(new w.MouseEvent('click', { bubbles: true }));
+    assert.ok(doc.getElementById('sheetLibrary').classList.contains('open'));
+    App.closeSheet('sheetLibrary');
+  } finally {
+    env.close();
+  }
+});
diff --git a/tests/load/k6.js b/tests/load/k6.js
new file mode 100644
index 0000000..de38519
--- /dev/null
+++ b/tests/load/k6.js
@@ -0,0 +1,101 @@
+/* =====================================================================
+ *  tests/load/k6.js — prueba de carga básica de Aurora Music Player
+ *
+ *  Requiere k6 (https://k6.io):  npm run test:load
+ *  Con la app levantada (npm start) y la URL en BASE_URL:
+ *      BASE_URL=http://localhost:3000 k6 run tests/load/k6.js
+ *
+ *  Qué mide: entrega de estáticos con lista blanca (index, JS, CSS,
+ *  icono), negociación gzip, ETag/304 y el endpoint /api/health con su
+ *  rate limit. No hay usuarios ni escrituras: la app es offline-first.
+ * ===================================================================== */
+
+import http from 'k6/http';
+import { check, sleep } from 'k6';
+import { Rate, Trend } from 'k6/metrics';
+
+const BASE_URL = __ENV.BASE_URL || 'http://localhost:3000';
+const RATE_LIMIT = Number(__ENV.API_RATE_LIMIT || 120);
+
+const cacheHits = new Rate('cache_hits_304');
+const gzipRatio = new Trend('gzip_size_ratio');
+
+export const options = {
+  scenarios: {
+    // 1) Humo: una pasada, falla rápido si el deploy está roto.
+    smoke: {
+      executor: 'per-vu-iterations',
+      vus: 1,
+      iterations: 1,
+      tags: { testid: 'smoke' }
+    },
+    // 2) Carga normal: 20 usuarios virtuales durante 30 s.
+    load: {
+      executor: 'ramping-vus',
+      startVUs: 0,
+      stages: [
+        { duration: '5s', target: 20 },
+        { duration: '20s', target: 20 },
+        { duration: '5s', target: 0 }
+      ],
+      startTime: '2s',
+      tags: { testid: 'load' }
+    }
+  },
+  thresholds: {
+    http_req_failed: ['rate<0.01'],            // < 1 % de errores
+    http_req_duration: ['p(95)<800'],          // p95 por debajo de 800 ms
+    checks: ['rate>0.99'],
+    'http_req_duration{testid:smoke}': ['p(95)<500']
+  }
+};
+
+const ASSETS = ['/', '/styles.css', '/js/main.js', '/js/audio.js', '/data.js', '/icon.png'];
+
+export default function () {
+  for (const path of ASSETS) {
+    const res = http.get(BASE_URL + path, { tags: { name: path } });
+    check(res, {
+      'estado 200': (r) => r.status === 200,
+      'tipo correcto': (r) => /text\/|image\/|javascript/.test(r.headers['Content-Type'] || ''),
+      'sin x-powered-by': (r) => !r.headers['X-Powered-By']
+    });
+    // Si es JS/CSS comprimible, comprobar que el servidor negoció gzip.
+    if (path.endsWith('.js') || path.endsWith('.css')) {
+      const len = Number(res.headers['Content-Length'] || 0);
+      if (res.headers['Content-Encoding'] === 'gzip' && len) {
+        gzipRatio.add(len / Math.max(1, res.body ? res.body.length : len));
+      }
+    }
+  }
+
+  // ETag → segunda petición condicional debe ser 304.
+  const first = http.get(BASE_URL + '/styles.css');
+  if (first.headers['Etag']) {
+    const second = http.get(BASE_URL + '/styles.css', {
+      headers: { 'If-None-Match': first.headers['Etag'] }
+    });
+    cacheHits.add(second.status === 304);
+    check(second, { '304 con ETag': (r) => r.status === 304 });
+  }
+
+  // Salud del API (consume una unidad del rate limit por iteración).
+  const health = http.get(BASE_URL + '/api/health');
+  check(health, {
+    'health 200 o 429': (r) => r.status === 200 || r.status === 429,
+    'health json': (r) => r.status !== 200 || (r.headers['Content-Type'] || '').includes('application/json')
+  });
+
+  sleep(1);
+}
+
+/* Aviso si el rate limit es más bajo que las peticiones esperadas del
+ * escenario de carga: el 429 es correcto, pero conviene saberlo. */
+export function handleSummary(data) {
+  const limited = data.metrics && data.metrics.http_reqs
+    ? data.metrics.http_reqs.values.count : 0;
+  if (limited > RATE_LIMIT * 60) {
+    console.warn('[k6] Se superó API_RATE_LIMIT: los 429 son esperados.');
+  }
+  return { stdout: JSON.stringify(data, null, 2) };
+}
diff --git a/tests/unit/i18n.test.js b/tests/unit/i18n.test.js
new file mode 100644
index 0000000..1e5e329
--- /dev/null
+++ b/tests/unit/i18n.test.js
@@ -0,0 +1,124 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+const ROOT = path.join(__dirname, '..', '..');
+const ctx = { window: {} };
+ctx.window = ctx;
+vm.createContext(ctx);
+vm.runInContext(fs.readFileSync(path.join(ROOT, 'data.js'), 'utf8'), ctx);
+const I18N = ctx.I18N;
+const LANGS = Array.from(ctx.SUPPORTED_LANGS, l => l.code);
+
+function projectSources() {
+  const files = ['index.html', 'uploader.js', 'webxdc.js'];
+  for (const f of fs.readdirSync(path.join(ROOT, 'js'))) {
+    if (f.endsWith('.js')) files.push('js/' + f);
+  }
+  return files.map(f => {
+    let src = fs.readFileSync(path.join(ROOT, f), 'utf8');
+    // Quitar comentarios para no confundir ejemplos de documentación
+    // (`data-i18n="key"` en un comentario) con usos reales.
+    src = src.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(^|[^:])\/\/.*$/gm, '$1');
+    return { f, src };
+  });
+}
+
+function usedKeys() {
+  const used = new Map();
+  for (const { f, src } of projectSources()) {
+    let m;
+    const re1 = /\bt\(\s*'([a-z0-9_]+)'/g;
+    while ((m = re1.exec(src))) {
+      // Claves dinámicas: t('accent_' + this.accent). Se validan aparte.
+      if (/^\s*\+/.test(src.slice(re1.lastIndex, re1.lastIndex + 8))) continue;
+      if (!used.has(m[1])) used.set(m[1], new Set());
+      used.get(m[1]).add(f);
+    }
+    const re2 = /data-i18n(?:-ph|-title|-aria)?="([a-z0-9_]+)"/g;
+    while ((m = re2.exec(src))) {
+      if (!used.has(m[1])) used.set(m[1], new Set());
+      used.get(m[1]).add(f);
+    }
+  }
+  return used;
+}
+
+test('los 8 idiomas están completos en todas las claves', () => {
+  assert.deepEqual(LANGS.sort(), ['en', 'es', 'fr', 'it', 'ja', 'pt', 'ru', 'zh'].sort());
+  const problems = [];
+  for (const [key, dict] of Object.entries(I18N)) {
+    for (const lang of LANGS) {
+      if (!dict[lang] || !String(dict[lang]).trim()) problems.push(key + ':' + lang);
+    }
+  }
+  assert.deepEqual(problems, []);
+});
+
+test('las claves dinámicas accent_* existen para todos los acentos', () => {
+  const html = fs.readFileSync(path.join(ROOT, 'index.html'), 'utf8');
+  const accents = [...html.matchAll(/data-accent="([a-z]+)"/g)].map(m => m[1]);
+  assert.ok(accents.length >= 4);
+  for (const a of accents) assert.ok(I18N['accent_' + a], 'falta accent_' + a);
+});
+
+test('todas las claves usadas por el código existen en I18N', () => {
+  const used = usedKeys();
+  const missing = [...used.keys()].filter(k => !I18N[k]);
+  assert.deepEqual(missing, []);
+});
+
+test('todas las claves de data-i18n del HTML existen', () => {
+  const html = fs.readFileSync(path.join(ROOT, 'index.html'), 'utf8');
+  const keys = new Set();
+  let m;
+  const re = /data-i18n(?:-ph|-title|-aria)?="([a-z0-9_]+)"/g;
+  while ((m = re.exec(html))) keys.add(m[1]);
+  assert.deepEqual([...keys].filter(k => !I18N[k]), []);
+  assert.ok(keys.size > 80, 'el HTML debe usar i18n de forma extensiva');
+});
+
+test('las claves con placeholders los conservan en los 8 idiomas', () => {
+  const checks = [
+    ['ab_active', ['X', 'Y']],
+    ['ab_set_a', ['X']],
+    ['batch_selected_count', ['X']],
+    ['batch_updated_toast', ['X']],
+    ['batch_deleted_toast', ['X']],
+    ['batch_delete_confirm', ['X']],
+    ['delete_multiple_confirm', ['X']],
+    ['toast_sleep_started', ['X']],
+    ['storage_usage', ['X', 'Y']],
+    ['relink_pending', ['X']]
+  ];
+  for (const [key, tokens] of checks) {
+    assert.ok(I18N[key], 'falta ' + key);
+    for (const lang of LANGS) {
+      for (const token of tokens) {
+        assert.ok(String(I18N[key][lang]).includes(token),
+          `${key}/${lang} no contiene ${token}`);
+      }
+    }
+  }
+});
+
+test('no quedan placeholders sin sustituir en textos visibles auditados', () => {
+  // La app sustituye con .replace('X', …): un literal X/Y suelto se
+  // convertiría en un número por accidente. Solo se revisan las claves
+  // que realmente se usan con replace().
+  const REPLACED = new Set([
+    'ab_active', 'ab_set_a', 'batch_selected_count', 'batch_updated_toast',
+    'batch_deleted_toast', 'batch_delete_confirm', 'delete_multiple_confirm',
+    'toast_sleep_started', 'storage_usage', 'relink_pending'
+  ]);
+  for (const key of REPLACED) {
+    for (const lang of LANGS) {
+      const s = String(I18N[key][lang]);
+      assert.ok(!/\{\{|\}\}|%[sd]/.test(s), key + '/' + lang + ' usa un placeholder no soportado');
+    }
+  }
+});
diff --git a/tests/unit/lrc.test.js b/tests/unit/lrc.test.js
new file mode 100644
index 0000000..07171ba
--- /dev/null
+++ b/tests/unit/lrc.test.js
@@ -0,0 +1,87 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+/* lyrics.js es un script clásico que amplía el global App. */
+global.App = { esc: (s) => String(s), t: (k) => k };
+require('../../js/lyrics.js');
+const App = global.App;
+
+test('parseLrc: timestamps simples, ordenados', () => {
+  const lines = App.parseLrc([
+    '[00:10.00]Segunda',
+    '[00:02.50]Primera'
+  ]);
+  assert.equal(lines.hasTimed, true);
+  assert.deepEqual(lines.map(l => l.text), ['Primera', 'Segunda']);
+  assert.equal(lines[0].time, 2.5);
+});
+
+test('parseLrc: varios timestamps en una línea generan varias entradas', () => {
+  const lines = App.parseLrc(['[00:01.00][00:11.00]Coro']);
+  assert.equal(lines.filter(l => l.text === 'Coro').length, 2);
+  assert.deepEqual(lines.map(l => l.time), [1, 11]);
+});
+
+test('parseLrc: aplica [offset:] (positivo y negativo)', () => {
+  const plus = App.parseLrc(['[offset:500]', '[00:10.00]Hola']);
+  assert.equal(plus[0].time, 10.5);
+  const minus = App.parseLrc(['[offset:-1500]', '[00:10.00]Hola']);
+  assert.equal(minus[0].time, 8.5);
+});
+
+test('parseLrc: nunca devuelve tiempos negativos', () => {
+  const lines = App.parseLrc(['[offset:-99000]', '[00:01.00]Hola']);
+  assert.equal(lines[0].time, 0);
+});
+
+test('parseLrc: fusiona líneas con el mismo timestamp como traducción', () => {
+  const lines = App.parseLrc(['[00:01.00]Hello', '[00:01.00]Hola']);
+  assert.equal(lines.length, 1);
+  assert.equal(lines[0].text, 'Hello');
+  assert.equal(lines[0].translation, 'Hola');
+});
+
+test('parseLrc: metadata [ar:] no se muestra y texto plano se conserva', () => {
+  const lines = App.parseLrc(['[ar:Artista]', '[ti:Título]', 'Sin timestamp']);
+  assert.equal(lines.length, 1);
+  assert.equal(lines[0].text, 'Sin timestamp');
+  assert.equal(lines[0].timed, false);
+});
+
+test('parseLrc: acepta string además de array', () => {
+  const lines = App.parseLrc('[00:03.00]Uno\r\n[00:04.00]Dos');
+  assert.equal(lines.length, 2);
+  assert.equal(lines[0].text, 'Uno');
+});
+
+test('parseLrc: karaoke aplica el offset global a los tags <mm:ss>', () => {
+  const lines = App.parseLrc([
+    '[offset:1000]',
+    '[00:10.00]<00:10.00>Hola <00:11.00>mundo'
+  ]);
+  assert.equal(lines.length, 1);
+  assert.ok(Array.isArray(lines[0].words));
+  assert.deepEqual(lines[0].words.map(w => w.time), [11, 12]);
+  assert.equal(lines[0].words[0].text, 'Hola ');
+  assert.equal(lines[0].words[1].text, 'mundo');
+});
+
+test('stripKaraokeTags elimina solo tags bien formados', () => {
+  assert.equal(App.stripKaraokeTags('a <00:01.00>b'), 'a b');
+  assert.equal(App.stripKaraokeTags('a <b> c'), 'a <b> c');
+});
+
+test('parseLrc: entrada vacía o basura no explota', () => {
+  assert.deepEqual(App.parseLrc(null), []);
+  assert.deepEqual(App.parseLrc([]), []);
+  assert.equal(App.parseLrc([null, 42, '[00:01.00]ok']).length, 1);
+});
+
+test('parseKaraokeWords: exige al menos 2 tags con texto', () => {
+  assert.equal(App.parseKaraokeWords('sin tags', 0, 0), null);
+  assert.equal(App.parseKaraokeWords('<00:01.00>Solo', 0, 0), null);
+  const words = App.parseKaraokeWords('<00:01.00>a<00:02.00>b', 0, 0);
+  assert.deepEqual(words.map(w => w.time), [1, 2]);
+});
