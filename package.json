{
  "name": "aurora-music-player",
  "version": "1.2.0",
  "description": "Offline-first music player with synced lyrics, playlists, equalizer and stats.",
  "license": "MIT",
  "author": "Nelson",
  "repository": {
    "type": "git",
    "url": "https://github.com/nelsondev2/Aurora-Music-Player.git"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node -e \"console.log('Build complete (sin bundler: la app se sirve tal cual)')\"",
    "lint": "node audit-i18n.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js tests/a11y/*.test.js tests/e2e/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:a11y": "node --test tests/a11y/*.test.js",
    "test:coverage": "node scripts/coverage.js",
    "test:load": "k6 run tests/load/k6.js",
    "audit": "npm audit --audit-level=low",
    "test:e2e": "node --test tests/e2e/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "c8": "^12.0.0",
    "fake-indexeddb": "^6.2.6",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.3"
  },
  "keywords": [
    "music-player",
    "offline-first",
    "webxdc",
    "indexeddb",
    "web-audio",
    "lyrics"
  ]
}
